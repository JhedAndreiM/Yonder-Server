/* Trade Offer Interface - Yonder System Colors */

:root {
  /* Original Yonder Colors */
  --bg-main: #E9E9E9;
  --bg-secondary: #F5F5F5;
  --accent: #7B1E1E;
  --accent-light: #A83B3B;
  --border: #C5C5C5;
  --border-highlight: #e2e2e2;
  --text-primary: #1E1E1E;
  --text-secondary: #555555;
  --shadow: rgba(0, 0, 0, 0.08);
  
  /* Trade-specific adaptations */
  --card-bg: #FFFFFF;
  --card-hover: #F8F8F8;
  --success: #5cb85c;
  --warning: #f0ad4e;
  --danger: #d9534f;
  --info: #5bc0de;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: var(--bg-main);
  font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
  color: var(--text-primary);
  min-height: 100vh;
}

.trade-container {
  max-width: 1800px;
  margin: 0 auto;
  padding: 20px;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Header */
.trade-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
  padding: 20px 30px;
  background: var(--bg-secondary);
  border-radius: 8px;
  border: 1px solid var(--border);
  box-shadow: 0 2px 4px var(--shadow);
}

.trade-header-content h1 {
  font-size: 32px;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 5px;
}

.trade-subtitle {
  color: var(--text-secondary);
  font-size: 14px;
}

.trade-subtitle strong {
  color: var(--accent);
}

.btn-back {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 6px;
  color: var(--text-primary);
  text-decoration: none;
  font-weight: 500;
  transition: all 0.3s ease;
}

.btn-back:hover {
  background: var(--bg-secondary);
  border-color: var(--accent);
  color: var(--accent);
  transform: translateX(-3px);
}

/* Main Trade Content */
.trade-content {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 20px;
  flex: 1;
  margin-bottom: 20px;
}

/* Trade Panel */
.trade-panel {
  background: var(--card-bg);
  border-radius: 8px;
  border: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.panel-header {
  padding: 20px;
  background: rgba(0, 0, 0, 0.3);
  border-bottom: 1px solid var(--border-color);
}

.panel-title {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 15px;
}

.panel-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 2px solid var(--steam-blue);
  object-fit: cover;
}

.panel-title h2 {
  font-size: 20px;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0;
}

.panel-subtitle {
  color: var(--text-muted);
  font-size: 13px;
  margin: 0;
}

/* Search Box */
.search-box {
  position: relative;
  display: flex;
  align-items: center;
}

.search-box svg {
  position: absolute;
  left: 12px;
  color: var(--text-muted);
  pointer-events: none;
}

.search-input {
  width: 100%;
  padding: 10px 10px 10px 40px;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  color: var(--text-primary);
  font-size: 14px;
  transition: all 0.3s ease;
}

.search-input:focus {
  outline: none;
  border-color: var(--steam-blue);
  background: rgba(0, 0, 0, 0.6);
}

.search-input::placeholder {
  color: var(--text-muted);
}

/* Selected Items Area */
.selected-items-area {
  padding: 25px 20px 20px 20px;
  min-height: 180px;
  background: var(--bg-main);
  border-bottom: 2px solid var(--border);
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-content: flex-start;
}

.selected-items-area .empty-state {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  padding: 40px 20px;
}

.selected-items-area .empty-state svg {
  margin-bottom: 15px;
  opacity: 0.3;
}

.selected-items-area .empty-state p {
  font-size: 14px;
}

/* Selected Item Card */
.selected-item {
  position: relative;
  width: 140px;
  background: var(--card-hover);
  border: 2px solid var(--steam-blue);
  border-radius: 6px;
  overflow: hidden;
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.selected-item-image {
  width: 100%;
  height: 80px;
  object-fit: cover;
  display: block;
}

.selected-item-details {
  padding: 8px;
}

.selected-item-name {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selected-item-variant {
  font-size: 10px;
  color: var(--steam-blue);
  margin-bottom: 4px;
}

.selected-item-qty {
  font-size: 10px;
  color: var(--text-muted);
  font-weight: 500;
}

.btn-remove {
  position: absolute;
  top: 5px;
  right: 5px;
  width: 22px;
  height: 22px;
  background: var(--steam-danger);
  border: none;
  border-radius: 50%;
  color: white;
  font-size: 14px;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  opacity: 0.8;
}

.btn-remove:hover {
  opacity: 1;
  transform: scale(1.1);
  background: #c9302c;
}

/* Target Product Styling */
.selected-item.target-product {
  border: 2px solid var(--accent);
  box-shadow: 0 0 15px rgba(123, 30, 30, 0.3);
  position: relative;
}

.target-badge {
  position: absolute;
  top: 5px;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(90deg, var(--accent), var(--accent-light));
  color: white;
  padding: 4px 12px;
  border-radius: 12px;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: 0 2px 8px var(--shadow);
  z-index: 10;
  white-space: nowrap;
}

.item-card.target-product-card {
  border: 2px solid var(--accent);
  background: rgba(123, 30, 30, 0.05);
  position: relative;
}

.target-flag {
  position: absolute;
  top: 8px;
  left: 8px;
  background: linear-gradient(135deg, var(--accent), var(--accent-light));
  color: white;
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  z-index: 5;
  box-shadow: 0 2px 6px var(--shadow);
}

.item-card.target-product-card .btn-select {
  background: var(--accent);
  color: white;
  cursor: default;
}

/* Items Grid */
.items-grid {
  padding: 20px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 15px;
  overflow-y: auto;
  max-height: 500px;
}

.items-grid::-webkit-scrollbar {
  width: 8px;
}

.items-grid::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 4px;
}

.items-grid::-webkit-scrollbar-thumb {
  background: var(--steam-blue-dark);
  border-radius: 4px;
}

.items-grid::-webkit-scrollbar-thumb:hover {
  background: var(--steam-blue);
}

/* Item Card */
.item-card {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
}

.item-card:hover {
  transform: translateY(-4px);
  border-color: var(--steam-blue);
  box-shadow: 0 8px 16px rgba(6, 191, 255, 0.3);
}

.item-card.selected {
  border: 2px solid var(--steam-blue);
  background: var(--card-hover);
  opacity: 0.6;
}

.item-image {
  position: relative;
  width: 100%;
  height: 140px;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.3);
}

.item-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.item-card:hover .item-image img {
  transform: scale(1.1);
}

.item-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(6, 191, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.item-card:hover .item-overlay {
  opacity: 1;
}

.btn-select {
  padding: 10px 20px;
  background: white;
  color: var(--steam-blue-dark);
  border: none;
  border-radius: 6px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-select:hover {
  transform: scale(1.05);
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
}

.item-info {
  padding: 12px;
}

.item-name {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
  gap: 8px;
}

.item-price {
  font-size: 13px;
  font-weight: 600;
  color: var(--steam-blue);
}

.item-stock {
  font-size: 11px;
  color: var(--text-muted);
}

.item-condition {
  display: inline-block;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 600;
  border-radius: 12px;
  text-transform: uppercase;
}

.item-condition.new {
  background: rgba(92, 184, 92, 0.2);
  color: var(--steam-success);
  border: 1px solid var(--steam-success);
}

.item-condition.like-new,
.item-condition.like_new {
  background: rgba(91, 192, 222, 0.2);
  color: #5bc0de;
  border: 1px solid #5bc0de;
}

.item-condition.good {
  background: rgba(240, 173, 78, 0.2);
  color: var(--steam-warning);
  border: 1px solid var(--steam-warning);
}

.item-condition.fair {
  background: rgba(217, 83, 79, 0.2);
  color: var(--steam-danger);
  border: 1px solid var(--steam-danger);
}

/* No Items Message */
.no-items {
  grid-column: 1 / -1;
  text-align: center;
  padding: 60px 20px;
  color: var(--text-muted);
  font-size: 16px;
}

/* Trade Divider */
.trade-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60px;
}

.divider-icon {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 20px;
  background: rgba(6, 191, 255, 0.1);
  border: 1px solid var(--steam-blue-dark);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.7;
  }
  50% {
    transform: scale(1.1);
    opacity: 1;
  }
}

.divider-icon svg {
  color: var(--steam-blue);
}

/* Trade Footer */
.trade-footer {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 20px 30px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  bottom: 20px;
  backdrop-filter: blur(10px);
}

.trade-summary {
  display: flex;
  gap: 30px;
  align-items: center;
}

.summary-section {
  display: flex;
  align-items: center;
  gap: 10px;
}

.summary-label {
  color: var(--text-secondary);
  font-size: 14px;
}

.summary-count {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 32px;
  height: 32px;
  padding: 0 12px;
  background: var(--steam-blue-dark);
  color: white;
  font-weight: 700;
  font-size: 16px;
  border-radius: 6px;
}

.summary-divider {
  width: 1px;
  height: 30px;
  background: var(--border-color);
}

.trade-actions {
  display: flex;
  gap: 15px;
}

.btn-cancel,
.btn-send-offer {
  padding: 12px 28px;
  font-size: 15px;
  font-weight: 600;
  border-radius: 6px;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 8px;
}

.btn-cancel {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
}

.btn-cancel:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: var(--steam-danger);
  color: var(--steam-danger);
}

.btn-send-offer {
  background: linear-gradient(90deg, var(--steam-gradient-start), var(--steam-gradient-end));
  color: white;
  position: relative;
  overflow: hidden;
}

.btn-send-offer::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.2);
  transition: left 0.5s ease;
}

.btn-send-offer:hover::before {
  left: 100%;
}

.btn-send-offer:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(6, 191, 255, 0.4);
}

.btn-send-offer:disabled {
  background: var(--text-muted);
  cursor: not-allowed;
  opacity: 0.5;
}

.btn-send-offer:disabled:hover {
  transform: none;
  box-shadow: none;
}

/* Responsive Design */
@media (max-width: 1400px) {
  .trade-content {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .trade-divider {
    width: 100%;
    height: 60px;
    margin: 20px 0;
  }

  .divider-icon {
    flex-direction: row;
  }

  .divider-icon svg:last-child {
    transform: rotate(90deg) !important;
  }

  .divider-icon svg:first-child {
    transform: rotate(-90deg);
  }
}

@media (max-width: 768px) {
  .trade-header {
    flex-direction: column;
    gap: 15px;
    text-align: center;
  }

  .trade-footer {
    flex-direction: column;
    gap: 20px;
  }

  .trade-summary {
    flex-direction: column;
    gap: 15px;
    width: 100%;
  }

  .trade-actions {
    width: 100%;
    flex-direction: column;
  }

  .btn-cancel,
  .btn-send-offer {
    width: 100%;
    justify-content: center;
  }

  .items-grid {
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  }
}

/* Item Modal (for detailed view - optional) */
.item-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(5px);
}

.modal-content {
  position: relative;
  max-width: 800px;
  width: 90%;
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  overflow: hidden;
  z-index: 1;
}

.modal-close {
  position: absolute;
  top: 15px;
  right: 15px;
  width: 36px;
  height: 36px;
  background: rgba(0, 0, 0, 0.7);
  border: none;
  border-radius: 50%;
  color: white;
  font-size: 24px;
  cursor: pointer;
  transition: all 0.2s ease;
  z-index: 2;
}

.modal-close:hover {
  background: var(--steam-danger);
  transform: scale(1.1);
}

.modal-body {
  display: flex;
  gap: 30px;
  padding: 30px;
}

.modal-item-image {
  width: 300px;
  height: 300px;
  object-fit: cover;
  border-radius: 8px;
  border: 1px solid var(--border-color);
}

.modal-item-details {
  flex: 1;
}

.modal-item-details h2 {
  font-size: 24px;
  margin-bottom: 15px;
  color: var(--text-primary);
}

.modal-item-details p {
  color: var(--text-secondary);
  line-height: 1.6;
  margin-top: 15px;
}

/* Item Selection Modal */
.item-selection-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.selection-modal-content {
  position: relative;
  max-width: 500px;
  width: 90%;
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  overflow: hidden;
  z-index: 1;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
}

.selection-modal-header {
  background: rgba(0, 0, 0, 0.3);
  padding: 20px;
  border-bottom: 1px solid var(--border-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.selection-modal-header h2 {
  margin: 0;
  font-size: 20px;
  color: var(--text-primary);
}

.selection-modal-body {
  padding: 20px;
}

.modal-item-preview {
  display: flex;
  gap: 15px;
  margin-bottom: 20px;
  padding: 15px;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 8px;
}

.preview-image {
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: 6px;
}

.preview-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.preview-price {
  font-size: 20px;
  font-weight: 700;
  color: var(--steam-blue);
  margin: 0;
}

.modal-field {
  margin-bottom: 20px;
}

.modal-field label {
  display: block;
  margin-bottom: 8px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
}

.stock-info {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 400;
}

.modal-select {
  width: 100%;
  padding: 12px;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  color: var(--text-primary);
  font-size: 14px;
}

.modal-select:focus {
  outline: none;
  border-color: var(--steam-blue);
}

.quantity-controls {
  display: flex;
  gap: 10px;
  align-items: center;
}

.qty-btn {
  width: 40px;
  height: 40px;
  background: var(--steam-blue-dark);
  border: none;
  border-radius: 6px;
  color: white;
  font-size: 20px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.qty-btn:hover {
  background: var(--steam-blue);
  transform: scale(1.05);
}

.modal-quantity-input {
  flex: 1;
  padding: 12px;
  text-align: center;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  color: var(--text-primary);
  font-size: 16px;
  font-weight: 600;
}

.modal-quantity-input:focus {
  outline: none;
  border-color: var(--steam-blue);
}

.selection-modal-footer {
  display: flex;
  gap: 10px;
  margin-top: 25px;
}

.btn-modal-cancel,
.btn-modal-confirm {
  flex: 1;
  padding: 12px;
  border: none;
  border-radius: 6px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-modal-cancel {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
}

.btn-modal-cancel:hover {
  background: rgba(255, 255, 255, 0.1);
}

.btn-modal-confirm {
  background: linear-gradient(90deg, var(--steam-gradient-start), var(--steam-gradient-end));
  color: white;
}

.btn-modal-confirm:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(6, 191, 255, 0.4);
}
